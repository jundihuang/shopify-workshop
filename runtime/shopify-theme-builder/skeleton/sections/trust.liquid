<section class="card wrap">
  <h2>{{ section.settings.heading }}</h2>
  <ul>
    {% if section.settings.trust_1 != blank %}<li>{{ section.settings.trust_1 }}</li>{% endif %}
    {% if section.settings.trust_2 != blank %}<li>{{ section.settings.trust_2 }}</li>{% endif %}
    {% if section.settings.trust_3 != blank %}<li>{{ section.settings.trust_3 }}</li>{% endif %}
  </ul>
</section>

{% schema %}
{
  "name": "Trust",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
    { "type": "text", "id": "trust_1", "label": "Trust 1", "default": "" },
    { "type": "text", "id": "trust_2", "label": "Trust 2", "default": "" },
    { "type": "text", "id": "trust_3", "label": "Trust 3", "default": "" }
  ],
  "presets": [{ "name": "Trust" }]
}
{% endschema %}
