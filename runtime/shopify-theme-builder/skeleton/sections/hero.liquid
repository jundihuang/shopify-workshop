<section class="hero hero--banner">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 1920
      | image_tag:
        class: "hero__image",
        loading: "eager",
        widths: "800, 1200, 1600, 1920",
        sizes: "100vw",
        alt: section.settings.heading
    }}
  {%- else -%}
    <img
      class="hero__image"
      src="{{ 'banner-hero.jpg' | asset_url }}"
      alt="{{ section.settings.heading | escape }}"
      width="1920"
      height="960"
      loading="eager"
    >
  {%- endif -%}
  <div class="hero__overlay">
    <div class="wrap hero__content">
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_link != blank %}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Leave empty to use the bundled banner-hero.jpg." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Workshop" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/collections/all", "info": "Set to blank to hide the button." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
