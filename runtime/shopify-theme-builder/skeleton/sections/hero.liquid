<section class="hero wrap">
  <h1>{{ section.settings.heading }}</h1>
  {% if section.settings.text != blank %}
    <p>{{ section.settings.text }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Workshop" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
